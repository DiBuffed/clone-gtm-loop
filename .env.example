# Frontend demo: no credentials required. Never put secrets in NEXT_PUBLIC_*.
# Add server-only provider credentials when implementing authenticated adapters.

# GTM console: Node 24+, FFmpeg/ffprobe and a Korean font required.
# Generate two different values with: openssl rand -hex 32
GTM_ADMIN_TOKEN=
GTM_EVENTS_TOKEN=
GTM_PUBLIC_URL=http://localhost:3000
GTM_DATA_DIR=.gtm-data
GTM_MAX_DAILY_GENERATIONS=3
GTM_FONT_PATH=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
# Full copied KEY_ID:KEY_SECRET credential. API billing is separate from web credits.
HF_API_KEY=
# Add only exact trusted CDN hostnames returned by your Higgsfield account.
GTM_HF_MEDIA_HOSTS=higgsfield.ai
# Instagram Login professional-account token, user id and tested Graph version.
IG_ACCESS_TOKEN=
IG_USER_ID=
IG_GRAPH_VERSION=

# Full GTM loop: public audience research + structured strategy generation.
# These can also be saved encrypted from /gtm/loop after operator login.
TAVILY_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=
GTM_PRODUCT_HOSTS=yorigo.kr,www.yorigo.kr
